# Copy to .env (never commit .env). Read by the orchestrator via spring.config.import.
DB_PASSWORD=storyforge
PG_PORT=5432
STORYFORGE_DATA_DIR=C:/Users/you/storyforge-data

# Free NVIDIA API key from https://build.nvidia.com (starts with nvapi-). Used from M1.
NVIDIA_API_KEY=

# Telegram bot for notifications (M5).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free Cloudflare account for Workers AI images (M3): dash.cloudflare.com -> Account ID,
# and an API token with the "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# YouTube upload (M5): Google Cloud OAuth client of type "Desktop app".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# mock = make the Publish Kit only (you upload yourself); youtube = also upload as private + schedule.
STORYFORGE_PUBLISH=mock
# true = start a run every Monday 06:00 from the oldest topic in the backlog.
STORYFORGE_AUTOPILOT=false
